{
  "name": "cartiq",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @cartiq/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,css}\"",
    "db:migrate": "pnpm --filter @cartiq/web exec prisma migrate dev",
    "db:deploy": "pnpm --filter @cartiq/web exec prisma migrate deploy",
    "db:generate": "pnpm --filter @cartiq/web exec prisma generate",
    "db:studio": "pnpm --filter @cartiq/web exec prisma studio"
  },
  "devDependencies": {
    "prettier": "3.4.2",
    "typescript": "5.7.2"
  }
}
