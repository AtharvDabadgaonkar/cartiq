// CartIQ data model.
//
// Design notes:
//  - `events` is the append-only source of truth. Every funnel, segment and
//    experiment metric is derived from it by the SQL models in /models, so a
//    metric can always be traced back to rows.
//  - `Event.source` is the honesty mechanism: every row is labelled
//    REAL_DATASET, SIMULATED or LIVE_DEMO, and every surface that reports a
//    number reports which sources it covers.
//  - pgvector powers Module 4 catalog retrieval. Prisma has no native vector
//    type, so the column is `Unsupported` and queried with $queryRaw.

generator client {
  provider        = "prisma-client-js"
  // Needed to declare the pgvector extension in the datasource block.
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [vector]
}

// ---------------------------------------------------------------------------
// Provenance
// ---------------------------------------------------------------------------

/// Where a row came from. Never mix these in a reported number without saying so.
enum DataSource {
  /// Real public e-commerce dataset (see scripts/ingest.py).
  REAL_DATASET
  /// Generated by scripts/simulate.py. See docs/SIMULATION.md.
  SIMULATED
  /// Produced by a human clicking around the demo storefront.
  LIVE_DEMO
}

/// `unknown` is for sources that do not observe the field. The rule across
/// CartIQ: a field a source cannot observe is null or unknown, never invented.
enum DeviceType {
  desktop
  mobile
  tablet
  unknown
}

enum TrafficSource {
  direct
  organic
  paid_search
  social
  email
  referral
  unknown
}

/// Mirrors packages/shared/src/events.ts EVENT_TYPES. Kept in sync by
/// apps/api tests (test_schema_parity.py).
enum EventType {
  session_start
  page_view
  search
  product_view
  add_to_cart
  remove_from_cart
  checkout_start
  shipping_step
  payment_step
  purchase
  assistant_open
  assistant_query
  assistant_click
  recommendation_impression
  recommendation_click
  nudge_shown
  nudge_clicked
}

// ---------------------------------------------------------------------------
// Behavioural events
// ---------------------------------------------------------------------------

model Event {
  /// Client-generated UUID; makes re-ingestion idempotent.
  id        String    @id @map("event_id") @db.Uuid
  eventType EventType @map("event_type")
  timestamp DateTime  @db.Timestamptz(3)

  userId    String? @map("user_id") @db.VarChar(64)
  sessionId String  @map("session_id") @db.VarChar(64)

  device        DeviceType
  trafficSource TrafficSource @map("traffic_source")
  /// Null when the source cannot tell (an anonymous, unattributed order line).
  isNewUser     Boolean?      @map("is_new_user")

  /// Null for sources with no concept of a page (an imported order line).
  page      String?  @db.VarChar(512)
  productId String?  @map("product_id") @db.VarChar(64)
  /// Unit price for item events; order total for `purchase`.
  price     Decimal? @db.Decimal(12, 2)
  quantity  Int?

  /// { experimentKey: variantKey } stamped at event time.
  experimentAssignments Json @default("{}") @map("experiment_assignments")
  properties            Json @default("{}")

  source          DataSource @default(LIVE_DEMO)
  /// Links simulated rows back to the run that produced them.
  simulationRunId String?    @map("simulation_run_id") @db.Uuid

  ingestedAt DateTime @default(now()) @map("ingested_at") @db.Timestamptz(3)

  product       Product?       @relation(fields: [productId], references: [id], onDelete: SetNull)
  simulationRun SimulationRun? @relation(fields: [simulationRunId], references: [id], onDelete: Cascade)

  // Funnel queries scan by (type, time) and group by session; segment queries
  // filter by user. These three indexes cover every Module 1-3 query plan.
  @@index([eventType, timestamp])
  @@index([sessionId, timestamp])
  @@index([userId, timestamp])
  @@index([source, timestamp])
  @@map("events")
}

/// Provenance for one `make ingest` run of a real public dataset. Mirrors
/// SimulationRun: any real number can be traced to the import that produced it,
/// including what was dropped during cleaning and why.
model DatasetImport {
  id          String  @id @default(uuid()) @db.Uuid
  /// Source key, e.g. "online-retail-ii" or "rees46".
  source      String  @db.VarChar(64)
  /// Human-readable dataset name.
  name        String  @db.VarChar(256)
  url         String  @db.VarChar(1024)
  licence     String  @db.VarChar(128)
  attribution String
  /// SHA-256 of the source file, so an import is tied to exact bytes.
  checksum    String? @db.VarChar(64)

  rowsRead       Int  @map("rows_read")
  rowsLoaded     Int  @map("rows_loaded")
  /// { reason: count } for every row dropped during cleaning.
  rowsDropped    Json @map("rows_dropped")
  productsLoaded Int  @map("products_loaded")
  returnsLoaded  Int  @map("returns_loaded")

  /// Which funnel steps this source can actually observe. The console reads
  /// this rather than assuming every step is measurable.
  observableSteps String[] @map("observable_steps")

  gitSha    String?  @map("git_sha") @db.VarChar(40)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  returns ReturnLine[]

  @@index([source, createdAt])
  @@map("dataset_imports")
}

/// Real returns/cancellations from the source dataset. Kept out of `events`
/// because a return is a financial fact, not a browsing behaviour; the Phase 7
/// return-rate guardrail reads this table.
model ReturnLine {
  id              String     @id @default(uuid()) @db.Uuid
  /// Cancellation invoice id from the source dataset.
  orderId         String     @map("order_id") @db.VarChar(64)
  /// Invoice being cancelled, when the source makes that link. Usually absent.
  originalOrderId String?    @map("original_order_id") @db.VarChar(64)
  userId          String?    @map("user_id") @db.VarChar(64)
  productId       String?    @map("product_id") @db.VarChar(64)
  /// Positive count of units returned.
  quantity        Int
  unitPrice       Decimal    @map("unit_price") @db.Decimal(12, 2)
  occurredAt      DateTime   @map("occurred_at") @db.Timestamptz(3)
  source          DataSource @default(REAL_DATASET)
  datasetImportId String?    @map("dataset_import_id") @db.Uuid

  datasetImport DatasetImport? @relation(fields: [datasetImportId], references: [id], onDelete: Cascade)

  @@index([occurredAt])
  @@index([userId])
  @@map("return_lines")
}

/// Provenance + parameters for one `make simulate` run, so any simulated
/// number can be reproduced exactly.
model SimulationRun {
  id        String   @id @default(uuid()) @db.Uuid
  label     String   @db.VarChar(128)
  seed      Int
  /// Full parameter set, as documented in docs/SIMULATION.md.
  params    Json
  sessions  Int
  gitSha    String?  @map("git_sha") @db.VarChar(40)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  events Event[]

  @@map("simulation_runs")
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

model Product {
  id           String  @id @db.VarChar(64)
  title        String  @db.VarChar(512)
  description  String?
  brand        String? @db.VarChar(128)
  category     String  @db.VarChar(256)
  /// Raw category path from the source dataset, e.g. "apparel.shoes.running".
  categoryPath String? @map("category_path") @db.VarChar(512)
  price        Decimal @db.Decimal(12, 2)
  currency     String  @default("USD") @db.VarChar(3)
  imageUrl     String? @map("image_url") @db.VarChar(1024)
  /// GTIN/EAN/UPC. Absent for most rows; Module 6 scores that gap.
  gtin         String? @db.VarChar(32)
  inStock      Boolean @default(true) @map("in_stock")
  /// Structured attributes used by assistant filtering (size, width, material...).
  attributes   Json    @default("{}")

  /// TRUE when any field was synthesised because the source dataset lacked it.
  /// Surfaced in the UI so no generated text is passed off as real data.
  generated       Boolean  @default(false)
  /// Names of the specific generated fields.
  generatedFields String[] @default([]) @map("generated_fields")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  events      Event[]
  embedding   ProductEmbedding?
  suggestions CatalogSuggestion[]

  @@index([category])
  @@index([brand])
  @@index([price])
  @@map("products")
}

/// Catalog retrieval vectors. Dimension must match EMBEDDING_DIM.
model ProductEmbedding {
  productId  String                     @id @map("product_id") @db.VarChar(64)
  /// pgvector column; queried with `<=>` via $queryRaw.
  embedding  Unsupported("vector(384)")
  model      String                     @db.VarChar(128)
  /// Exact text that was embedded, so retrieval is reproducible.
  sourceText String                     @map("source_text")
  updatedAt  DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_embeddings")
}

enum SuggestionStatus {
  suggested
  accepted
  rejected
}

/// Module 6: AI-suggested catalog fixes. Written as suggestions only; applying
/// one is an explicit human action that records who accepted it.
model CatalogSuggestion {
  id             String           @id @default(uuid()) @db.Uuid
  productId      String           @map("product_id") @db.VarChar(64)
  field          String           @db.VarChar(64)
  currentValue   String?          @map("current_value")
  suggestedValue String           @map("suggested_value")
  rationale      String?
  /// Model confidence in [0,1], as reported by the provider.
  confidence     Decimal?         @db.Decimal(4, 3)
  status         SuggestionStatus @default(suggested)
  llmCallId      String?          @map("llm_call_id") @db.Uuid
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  product Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  llmCall LlmCall? @relation(fields: [llmCallId], references: [id], onDelete: SetNull)

  @@index([productId, field])
  @@map("catalog_suggestions")
}

// ---------------------------------------------------------------------------
// Experiments & flags
// ---------------------------------------------------------------------------

enum ExperimentStatus {
  draft
  running
  stopped
  completed
}

enum MetricRole {
  primary
  secondary
  guardrail
}

enum MetricType {
  proportion
  mean
}

model Experiment {
  id         String           @id @default(uuid()) @db.Uuid
  /// Stable key used in the assignment hash. Never change it on a live test.
  key        String           @unique @db.VarChar(64)
  name       String           @db.VarChar(256)
  hypothesis String
  status     ExperimentStatus @default(draft)

  /// Share of eligible traffic in the experiment, for staged rollout.
  exposure             Decimal  @default(1.0) @db.Decimal(4, 3)
  /// Minimum detectable effect, relative (0.05 = 5%).
  mde                  Decimal  @db.Decimal(5, 4)
  alpha                Decimal  @default(0.05) @db.Decimal(4, 3)
  power                Decimal  @default(0.8) @db.Decimal(4, 3)
  /// Required sample size per variant, computed at creation time.
  sampleSizePerVariant Int      @map("sample_size_per_variant")
  /// Baseline conversion rate the sample size was computed from.
  baselineRate         Decimal? @map("baseline_rate") @db.Decimal(6, 5)

  startedAt DateTime? @map("started_at") @db.Timestamptz(3)
  endedAt   DateTime? @map("ended_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  variants ExperimentVariant[]
  metrics  ExperimentMetric[]
  flags    FeatureFlag[]

  @@map("experiments")
}

model ExperimentVariant {
  id           String  @id @default(uuid()) @db.Uuid
  experimentId String  @map("experiment_id") @db.Uuid
  key          String  @db.VarChar(64)
  name         String  @db.VarChar(128)
  /// Traffic share in [0,1]; weights per experiment must sum to 1.
  weight       Decimal @db.Decimal(5, 4)
  isControl    Boolean @default(false) @map("is_control")
  /// Order fixed at creation, so adding a variant cannot reshuffle buckets.
  position     Int

  experiment Experiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)

  @@unique([experimentId, key])
  @@map("experiment_variants")
}

model ExperimentMetric {
  id                 String     @id @default(uuid()) @db.Uuid
  experimentId       String     @map("experiment_id") @db.Uuid
  /// Key into models/metrics; see docs/METRICS_DICTIONARY.md.
  metricKey          String     @map("metric_key") @db.VarChar(64)
  role               MetricRole
  type               MetricType
  /// For guardrails: the worst acceptable relative change (e.g. -0.01).
  guardrailThreshold Decimal?   @map("guardrail_threshold") @db.Decimal(6, 4)
  /// true when a decrease is good (e.g. abandonment rate).
  lowerIsBetter      Boolean    @default(false) @map("lower_is_better")

  experiment Experiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)

  @@unique([experimentId, metricKey])
  @@map("experiment_metrics")
}

/// Flags gate every intervention (nudges, assistant, personalisation) so each
/// can be rolled out or killed independently of the experiment that proved it.
model FeatureFlag {
  id           String   @id @default(uuid()) @db.Uuid
  key          String   @unique @db.VarChar(64)
  description  String
  enabled      Boolean  @default(false)
  /// Percentage rollout in [0,1] when not tied to an experiment.
  rollout      Decimal  @default(0) @db.Decimal(4, 3)
  /// When set, the flag's value follows the experiment assignment instead.
  experimentId String?  @map("experiment_id") @db.Uuid
  /// Variant key that turns the flag on.
  onVariant    String?  @map("on_variant") @db.VarChar(64)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  experiment Experiment? @relation(fields: [experimentId], references: [id], onDelete: SetNull)

  @@map("feature_flags")
}

/// Recorded exposures. Assignment itself is a pure hash, so this table exists
/// only for the sample-ratio-mismatch check and for debugging.
model ExperimentExposure {
  id            String     @id @default(uuid()) @db.Uuid
  experimentKey String     @map("experiment_key") @db.VarChar(64)
  variantKey    String     @map("variant_key") @db.VarChar(64)
  unitId        String     @map("unit_id") @db.VarChar(64)
  firstSeenAt   DateTime   @default(now()) @map("first_seen_at") @db.Timestamptz(3)
  source        DataSource @default(LIVE_DEMO)

  @@unique([experimentKey, unitId])
  @@index([experimentKey, variantKey])
  @@map("experiment_exposures")
}

// ---------------------------------------------------------------------------
// AI observability
// ---------------------------------------------------------------------------

/// Every LLM call plus the exact context it was given. Module 4's grounding
/// and hallucination metrics are computed from this table.
model LlmCall {
  id       String @id @default(uuid()) @db.Uuid
  purpose  String @db.VarChar(64)
  provider String @db.VarChar(32)
  model    String @db.VarChar(128)

  prompt    String
  /// Array of { id, source, text, score } the model was allowed to use.
  grounding Json
  response  String

  refused       Boolean
  citedIds      String[] @map("cited_ids")
  /// Cited ids absent from `grounding`: ungrounded by construction.
  ungroundedIds String[] @map("ungrounded_ids")

  inputTokens  Int     @map("input_tokens")
  outputTokens Int     @map("output_tokens")
  latencyMs    Int     @map("latency_ms")
  error        String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  suggestions CatalogSuggestion[]

  @@index([purpose, createdAt])
  @@map("llm_calls")
}
