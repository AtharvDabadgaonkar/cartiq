# ---------------------------------------------------------------------------
# CartIQ environment. Copy to `.env` (`make env`) and fill in as needed.
# Every value below is a safe local default; no secrets are ever committed.
# ---------------------------------------------------------------------------

# --- Database ---------------------------------------------------------------
# Local docker-compose Postgres (port 5433 to avoid clashing with a host PG).
DATABASE_URL="postgresql://cartiq:cartiq@localhost:5433/cartiq?schema=public"
# Supabase in production uses a pooled URL for the app and a direct URL for migrations.
DIRECT_URL="postgresql://cartiq:cartiq@localhost:5433/cartiq?schema=public"

# --- Web app ----------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Base URL of the FastAPI analytics/ML service (local dev only; the deployed
# console imports the analytics package directly instead of calling it).
NEXT_PUBLIC_API_URL="http://localhost:8000"
# Base URL of the Streamlit console. Set to the Streamlit Cloud URL in production.
NEXT_PUBLIC_CONSOLE_URL="http://localhost:8501"
# Shared secret the web app uses to call privileged API routes. Change in prod.
API_INTERNAL_TOKEN="dev-only-insecure-token"

# --- Analytics / ML API -----------------------------------------------------
API_HOST="0.0.0.0"
API_PORT="8000"
# Comma-separated CORS origins allowed to call the API.
API_CORS_ORIGINS="http://localhost:3000"

# --- LLM provider -----------------------------------------------------------
# "mock" runs the whole app and the full test suite with NO API key. Default.
# Other values: "anthropic" | "openai"
LLM_PROVIDER="mock"
LLM_MODEL="claude-sonnet-4-5"
# Only needed when LLM_PROVIDER != "mock".
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
# Embeddings for catalog retrieval. "mock" = deterministic hashed embeddings.
EMBEDDING_PROVIDER="mock"
EMBEDDING_MODEL="text-embedding-3-small"
EMBEDDING_DIM="384"

# --- Simulation -------------------------------------------------------------
# Fixed seed keeps `make simulate` reproducible. See docs/SIMULATION.md.
SIM_SEED="42"
SIM_SESSIONS="60000"

# --- Feature flags ----------------------------------------------------------
# Salt for deterministic hash-based experiment assignment. Changing it
# reshuffles every assignment, so keep it stable for the life of a test.
FLAG_HASH_SALT="cartiq-v1"
